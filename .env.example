# ─── Prava (Server-side ONLY — NEVER prefix with NEXT_PUBLIC_) ─
MERCHANT_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Browserbase / Stagehand ──────────────────────────────────
STEEL_API_KEY=steel_your_api_key_here
STEEL_COUNTRY=IN
# Set to 1 only if your Steel plan supports these features.
STEEL_STEALTH=1
STEEL_SOLVE_CAPTCHA=0
BROWSERBASE_API_KEY=bb_live_your_key_here
BROWSERBASE_PROJECT_ID=your-project-id-here

# ─── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRAVA_API_BASE=https://api.prava.space

# Chat integrations
TELEGRAM_BOT_TOKEN=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=

# Amazon session cookies (JSON array). Export from a logged-in browser.
# Example: [{"name":"session-id","value":"...","domain":".amazon.in"},{"name":"session-id-time","value":"...","domain":".amazon.in"}]
AMAZON_SESSION_COOKIES=

# Logged-in Swiggy web cookies, exported as a JSON array. The MCP OAuth token
# does not authenticate a separate Steel browser session.
SWIGGY_SESSION_COOKIES=
SWIGGY_AUTO_ORDER=0
SWIGGY_MCP_TOKEN=
# Logged-in Zepto web cookies for the Steel card-checkout fallback.
ZEPTO_SESSION_COOKIES=
ZEPTO_MCP_TOKEN=
ZEPTO_AUTO_ORDER=0
