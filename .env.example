# ─── Prava (Server-side ONLY — NEVER prefix with NEXT_PUBLIC_) ─
MERCHANT_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Global emergency stop. Live purchase execution is disabled unless this is
# explicitly set to 1 after every rollout gate has passed.
PURCHASES_ENABLED=0
MERCHANT_EXECUTION_ENABLED=0

# ─── OpenAI / Groq ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Browserbase / Stagehand ──────────────────────────────────
STEEL_API_KEY=steel_your_api_key_here
STEEL_COUNTRY=IN
# Set to 1 only if your Steel plan supports these features.
STEEL_STEALTH=1
STEEL_SOLVE_CAPTCHA=0
BROWSERBASE_API_KEY=bb_live_your_key_here
BROWSERBASE_PROJECT_ID=your-project-id-here

# ─── App Config ────────────────────────────────────────────────
APP_BASE_URL=https://app.example.com
PRAVA_API_BASE=https://sandbox.api.prava.space
INTERNAL_WORKER_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret

# ─── Supabase Auth / Database ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-side only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chat integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-secret-token
LINQ_API_KEY=
LINQ_FROM_NUMBER=
LINQ_WEBHOOK_SECRET=
SWIGGY_AUTO_ORDER=0
ZEPTO_AUTO_ORDER=0
