# ─── Prava (Server-side ONLY — NEVER prefix with NEXT_PUBLIC_) ─
MERCHANT_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Browserbase / Stagehand ──────────────────────────────────
BROWSERBASE_API_KEY=bb_live_your_key_here
BROWSERBASE_PROJECT_ID=your-project-id-here

# ─── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRAVA_API_BASE=https://api.prava.space

# Chat integrations
TELEGRAM_BOT_TOKEN=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=

# Amazon session cookies (JSON array). Export from a logged-in browser.
# Example: [{"name":"session-id","value":"...","domain":".amazon.in"},{"name":"session-id-time","value":"...","domain":".amazon.in"}]
AMAZON_SESSION_COOKIES=
